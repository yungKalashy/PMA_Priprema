<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pregled podataka"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:id="@+id/summaryFoto"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Fotografija studenta" />

        <TextView
            android:id="@+id/summaryImePrezime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ime i prezime"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/summaryDatumRod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Datum rođenja"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#999999"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Podaci o studiju"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/summaryPredmet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Predmet"
            android:textSize="16sp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/summaryProfesor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profesor"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/summarySatiPR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sati predavanja"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/summarySatiLV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sati laboratorijskih vježbi"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/summaryIzborni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Izborni predmet"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonSpremi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Potvrdi i spremi studenta"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
